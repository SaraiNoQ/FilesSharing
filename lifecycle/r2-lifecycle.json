{
  "rules": [
    {
      "id": "delete-temp-objects-after-30-days",
      "enabled": true,
      "conditions": {
        "prefix": "tmp/"
      },
      "deleteObjectsTransition": {
        "condition": {
          "type": "Age",
          "maxAge": 2592000
        }
      }
    },
    {
      "id": "abort-incomplete-multipart-after-1-day",
      "enabled": true,
      "conditions": {},
      "abortMultipartUploadsTransition": {
        "condition": {
          "type": "Age",
          "maxAge": 86400
        }
      }
    }
  ]
}
